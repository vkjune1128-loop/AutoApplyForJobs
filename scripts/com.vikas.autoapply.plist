<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vikas.autoapply</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/vikaskumar/Documents/Projects/AutoApplyForJobs/scripts/run_morning.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/vikaskumar/Documents/Projects/AutoApplyForJobs</string>
    <key>StartCalendarInterval</key>
    <array>
        <!-- Morning run: 5:30 AM IST -->
        <dict>
            <key>Hour</key>
            <integer>5</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <!-- Afternoon run: 2:30 PM (14:30) IST -->
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/vikaskumar/Documents/Projects/AutoApplyForJobs/data/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vikaskumar/Documents/Projects/AutoApplyForJobs/data/launchd_stderr.log</string>
</dict>
</plist>
